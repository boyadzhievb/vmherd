# Herdfile — Terramino single-VM acceptance test
# Equivalent of hashicorp-education/learn-vagrant-get-started 3.Vagrantfile
#
# Run by test/e2e TestAcceptanceScenarios (VMHERD_E2E_SCENARIOS=1), see
# test/e2e/scenarios_test.go. Manual steps: vmherd up, then open
# http://localhost:8081

images:
  ubuntu:noble: https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img

vms:
  - name: terramino
    image: ubuntu:noble
    cpus: 2
    memory: 2048
    disk: 20G
    network:
      ip: 192.168.240.10
    ports:
      - host: 8080
        guest: 8080
      - host: 8081
        guest: 8081
    shared_folders:
      - host: ./terramino-go
        guest: /home/vagrant/terramino-go
    provision:
      - type: file
        source: ./install-dependencies.sh
        destination: /tmp/install-dependencies.sh
      - type: shell
        inline: |
          bash /tmp/install-dependencies.sh
      - type: shell
        inline: |
          cd /home/vagrant/terramino-go
          docker compose up -d
          docker update --restart unless-stopped $(docker compose ps -q)

network:
  name: vmherd-terramino-single
  subnet: 192.168.240.0/24
  dns: auto

ssh:
  user: vagrant
