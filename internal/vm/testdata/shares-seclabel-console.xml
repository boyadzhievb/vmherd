<?xml version="1.0" encoding="UTF-8"?>
<domain type="kvm">
  <name>vmherd-webapp-abcdef01-dev</name>
  <memory unit="MiB">2048</memory>
  <vcpu placement="static">4</vcpu>
  <os>
    <type arch="x86_64" machine="q35">hvm</type>
  </os>
  <features>
    <acpi></acpi>
    <apic></apic>
  </features>
  <cpu mode="host-passthrough"></cpu>
  <clock offset="utc"></clock>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <devices>
    <disk type="file" device="disk">
      <driver name="qemu" type="qcow2"></driver>
      <source file="/var/lib/libvirt/images/vmherd-webapp-abcdef01-dev.qcow2"></source>
      <target dev="vda" bus="virtio"></target>
    </disk>
    <disk type="file" device="cdrom">
      <driver name="qemu" type="raw"></driver>
      <source file="/var/lib/libvirt/images/vmherd-webapp-abcdef01-dev-seed.iso"></source>
      <target dev="sda" bus="sata"></target>
    </disk>
    <interface type="network">
      <source network="vmherd-webapp-abcdef01"></source>
      <mac address="52:54:00:11:22:33"></mac>
      <model type="virtio"></model>
    </interface>
    <serial type="file">
      <source path="/home/user/.local/state/vmherd/webapp-abcdef01/dev/console.log"></source>
      <target port="0"></target>
    </serial>
    <console type="pty">
      <target type="serial" port="0"></target>
    </console>
    <channel type="unix">
      <target type="virtio" name="org.qemu.guest_agent.0"></target>
    </channel>
    <input type="tablet" bus="usb"></input>
    <graphics type="vnc" autoSocket="yes"></graphics>
    <rng model="virtio">
      <backend model="random">/dev/urandom</backend>
    </rng>
    <memballoon model="virtio"></memballoon>
    <filesystem type="mount" accessmode="squash">
      <source dir="/home/user/projects/webapp"></source>
      <target dir="vmherd_share_0"></target>
    </filesystem>
  </devices>
  <seclabel type="static" model="dac" relabel="yes">
    <label>+1000:+992</label>
  </seclabel>
</domain>